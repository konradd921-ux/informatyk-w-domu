---
const phoneDisplay = "NUMER TELEFONU";
const realPhoneNumber = "";
const phoneHref = realPhoneNumber ? `tel:${realPhoneNumber.replace(/\s/g, "")}` : null;
const serviceArea = "Rzeszów i okolice";

const helpTopics = [
  "Telewizor lub dekoder nie działa",
  "Internet lub Wi‑Fi nie działa jak powinno",
  "Kupiłeś nowy telefon",
  "Telefon działa bardzo wolno",
  "Nie dochodzą SMS-y lub wiadomości",
  "Nie działają kamery",
  "Drukarka nie chce drukować",
  "Nie wiesz, co się stało",
];

const steps = [
  {
    title: "Dzwonisz",
    text: "Mówisz spokojnie, co się dzieje. Nie musisz używać fachowych słów.",
  },
  {
    title: "Przyjeżdżam do domu",
    text: "Sprawdzę problem na miejscu, tam gdzie sprzęt jest używany na co dzień.",
  },
  {
    title: "Rozwiązujemy problem",
    text: "Pomogę Ci to ustawić i wyjaśnię prostym językiem, co zostało zrobione.",
  },
];

const realLifeProblems = [
  "Po awarii prądu telewizor albo dekoder przestał działać.",
  "Telewizor nie działa? Czasem wystarczy wybrać właściwe wejście.",
  "Wi‑Fi działa tylko w części domu albo często się rozłącza.",
  "Internet w domu trzeba ustawić tak, żeby działał wygodniej na telefonach i telewizorze.",
  "Hasło do Wi‑Fi jest za trudne i chcesz je uprościć.",
  "Nowy telefon trzeba przygotować do normalnego używania.",
  "Konto Google, aplikacje, zdjęcia i kontakty trzeba przenieść na nowy telefon.",
  "Telefon zwolnił albo pokazuje podejrzane reklamy.",
  "Nie dochodzą SMS-y lub wiadomości trafiają w złe miejsce.",
  "Telefon sam włącza ciszę albo tryb „Nie przeszkadzać” i nie słychać połączeń.",
  "Kamery przestały działać po zmianie routera.",
  "Drukarka jest podłączona, ale nie chce drukować.",
];

const reasons = [
  "Przyjadę do Ciebie, więc nie musisz wozić sprzętu do serwisu.",
  "Pomagam prostym językiem, bez zbędnych technicznych wyjaśnień.",
  "Możesz spokojnie pytać — bez oceniania i pośpiechu.",
  "Zajmuję się codzienną technologią w domu: telefonem, telewizorem, Wi‑Fi, drukarką i kamerami.",
];
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Informatyk w Domu w Rzeszowie i okolicy. Pomoc z telefonem, telewizorem, Wi‑Fi, dekoderem, drukarką i kamerami. Nie musisz się znać — przyjadę i pomogę."
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="Informatyk w Domu" />
    <meta
      property="og:title"
      content="Informatyk w Domu Rzeszów | Pomoc z telefonem, Wi‑Fi i telewizorem"
    />
    <meta
      property="og:description"
      content="Nie musisz się znać. Przyjadę do Ciebie i pomogę z codzienną technologią w domu."
    />
    <title>Informatyk w Domu Rzeszów | Pomoc z telefonem, Wi‑Fi i telewizorem</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Przejdź do głównej treści</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Informatyk w Domu — strona główna">
        <span class="brand-mark" aria-hidden="true">ID</span>
        <span>Informatyk w Domu</span>
      </a>
      <nav class="site-nav" aria-label="Główna nawigacja">
        <a href="#pomoc">Z czym pomagam</a>
        <a href="#jak-to-dziala">Jak to działa</a>
      </nav>
      {
        phoneHref ? (
          <a class="header-phone" href={phoneHref} aria-label={`Zadzwoń do Informatyka w Domu: ${phoneDisplay}`}>
            Zadzwoń: {phoneDisplay}
          </a>
        ) : (
          <span class="header-phone header-phone-unavailable">Zadzwoń: {phoneDisplay}</span>
        )
      }
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-content">
          <p class="eyebrow">{serviceArea}</p>
          <h1 id="hero-title">Nie działa telewizor, internet albo telefon?</h1>
          <p class="hero-lead">Nie musisz się znać. Przyjadę do Ciebie i pomogę.</p>
          <p class="hero-note">
            Nie wiesz, co jest nie tak? Po prostu opowiedz, co się dzieje. Sprawdzę problem
            na miejscu.
          </p>
          <div class="hero-actions">
            {
              phoneHref ? (
                <a class="button button-primary" href={phoneHref} aria-label={`Zadzwoń do Informatyka w Domu: ${phoneDisplay}`}>
                  Zadzwoń
                </a>
              ) : (
                <span class="button button-primary button-unavailable">Zadzwoń</span>
              )
            }
            <span class="phone-placeholder">{phoneDisplay}</span>
          </div>
        </div>
        <aside class="hero-card">
          <strong>Pomoc z technologią w domu</strong>
          <p>Telefon, telewizor, dekoder, Wi‑Fi, drukarka albo kamery — przyjadę i pomogę Ci to ustawić.</p>
        </aside>
      </section>

      <section id="pomoc" class="section" aria-labelledby="help-title">
        <div class="section-heading">
          <p class="eyebrow">Codzienne problemy</p>
          <h2 id="help-title">Z czym mogę pomóc?</h2>
          <p>Wybierz opis, który najbardziej pasuje do Twojej sytuacji. Nie musisz znać przyczyny.</p>
        </div>
        <ul class="cards-grid">
          {helpTopics.map((topic) => <li class="problem-card"><span aria-hidden="true">✓</span><h3>{topic}</h3></li>)}
        </ul>
      </section>

      <section class="reassurance" aria-labelledby="reassurance-title">
        <div>
          <p class="eyebrow">Bez stresu</p>
          <h2 id="reassurance-title">Nie musisz wiedzieć, co jest nie tak.</h2>
        </div>
        <p>
          Wystarczy, że powiesz mi, co się dzieje. Przyjadę, sprawdzę problem na miejscu i
          wyjaśnię prostym językiem, co można zrobić. Nie oceniam, nie poganiam i nie oczekuję
          technicznej wiedzy.
        </p>
      </section>

      <section id="jak-to-dziala" class="section" aria-labelledby="steps-title">
        <div class="section-heading">
          <p class="eyebrow">Prosto i spokojnie</p>
          <h2 id="steps-title">Jak to działa?</h2>
        </div>
        <ol class="steps-grid">
          {steps.map((step, index) => (
            <li class="step-card">
              <span class="step-number" aria-hidden="true">{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="section examples" aria-labelledby="examples-title">
        <div class="section-heading">
          <p class="eyebrow">Przykłady z domu</p>
          <h2 id="examples-title">Takie sytuacje zdarzają się naprawdę</h2>
          <p>To nie musi być duża awaria. Czasem problem jest drobny, ale skutecznie utrudnia dzień.</p>
        </div>
        <ul class="example-list">
          {realLifeProblems.map((problem) => <li>{problem}</li>)}
        </ul>
      </section>

      <section class="section why" aria-labelledby="why-title">
        <div class="section-heading">
          <p class="eyebrow">Dlaczego taka pomoc?</p>
          <h2 id="why-title">Pomoc na miejscu, po ludzku</h2>
          <p>To nie jest zwykły katalog usług komputerowych. Chodzi o praktyczne rozwiązanie problemu w domu.</p>
        </div>
        <ul class="reason-list">
          {reasons.map((reason) => <li><p>{reason}</p></li>)}
        </ul>
      </section>

      <section class="final-cta" aria-labelledby="final-cta-title">
        <p class="eyebrow">{serviceArea}</p>
        <h2 id="final-cta-title">Masz problem z technologią w domu?</h2>
        <p>Nie musisz wiedzieć, jak go nazwać. Powiedz mi, co się dzieje.</p>
        {
          phoneHref ? (
            <a class="button button-primary" href={phoneHref} aria-label={`Zadzwoń do Informatyka w Domu: ${phoneDisplay}`}>
              Zadzwoń
            </a>
          ) : (
            <span class="button button-primary button-unavailable">Zadzwoń</span>
          )
        }
        <span>{phoneDisplay}</span>
      </section>
    </main>

    <footer class="site-footer">
      <p><strong>Informatyk w Domu</strong></p>
      <p>{serviceArea}</p>
      <p>Telefon: {phoneHref ? <a href={phoneHref}>{phoneDisplay}</a> : <span>{phoneDisplay}</span>}</p>
      <p>&copy; {new Date().getFullYear()} Informatyk w Domu</p>
    </footer>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --background: #fbf7ef;
    --surface: #ffffff;
    --surface-soft: #fffaf1;
    --text: #172033;
    --muted: #566174;
    --primary: #0f5f73;
    --primary-dark: #0a4352;
    --accent: #e8a33a;
    --border: #e7dccb;
    --shadow: 0 20px 50px rgba(23, 32, 51, 0.1);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--background);
    color: var(--text);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 18px;
    line-height: 1.6;
  }

  a {
    color: inherit;
  }

  .skip-link {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 10;
    transform: translateY(-150%);
    border-radius: 999px;
    background: var(--text);
    color: #ffffff;
    font-weight: 800;
    padding: 0.75rem 1rem;
    text-decoration: none;
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    max-width: 1180px;
    margin: 0 auto;
    padding: 1rem clamp(1rem, 4vw, 2rem);
  }

  .brand,
  .site-nav,
  .header-phone,
  .button {
    min-height: 48px;
  }

  .brand {
    display: inline-flex;
    flex: 1 1 220px;
    align-items: center;
    gap: 0.75rem;
    color: var(--text);
    font-weight: 800;
    text-decoration: none;
  }

  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: var(--primary);
    color: #ffffff;
    font-size: 0.9rem;
    letter-spacing: 0.03em;
  }

  .site-nav {
    display: flex;
    flex: 1 1 260px;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.98rem;
  }

  .site-nav a {
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--primary-dark);
  }

  .header-phone {
    display: inline-flex;
    flex: 0 1 auto;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--primary-dark);
    font-weight: 800;
    padding: 0.7rem 1rem;
    text-align: center;
    text-decoration: none;
  }

  .header-phone-unavailable,
  .button-unavailable {
    cursor: default;
  }

  .button-unavailable {
    opacity: 0.9;
  }

  main {
    overflow: hidden;
  }

  .hero,
  .section,
  .reassurance,
  .final-cta,
  .site-footer {
    max-width: 1180px;
    margin: 0 auto;
    padding-right: clamp(1rem, 4vw, 2rem);
    padding-left: clamp(1rem, 4vw, 2rem);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.6fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }

  .eyebrow {
    margin: 0 0 0.8rem;
    color: var(--primary);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
    overflow-wrap: break-word;
  }

  h1 {
    max-width: 820px;
    margin-bottom: 1rem;
    font-size: clamp(2.45rem, 8vw, 5.2rem);
    line-height: 1.03;
    letter-spacing: -0.06em;
  }

  h2 {
    margin-bottom: 0.8rem;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  h3 {
    margin-bottom: 0;
    font-size: 1.18rem;
    line-height: 1.3;
  }

  .hero-lead {
    max-width: 720px;
    margin-bottom: 0.75rem;
    color: var(--primary-dark);
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-weight: 800;
    line-height: 1.25;
  }

  .hero-note,
  .section-heading p,
  .step-card p,
  .final-cta p,
  .hero-card p {
    color: var(--muted);
  }

  .hero-note {
    max-width: 640px;
    margin-bottom: 2rem;
    font-size: 1.12rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.95rem 1.45rem;
    font-size: 1.1rem;
    font-weight: 900;
    text-decoration: none;
  }

  .button-primary {
    background: var(--primary);
    color: #ffffff;
    box-shadow: 0 14px 28px rgba(15, 95, 115, 0.24);
  }

  .button-primary:hover,
  .button-primary:focus-visible {
    background: var(--primary-dark);
  }

  .phone-placeholder {
    color: var(--primary-dark);
    font-size: 1.1rem;
    font-weight: 800;
  }

  .hero-card {
    border: 1px solid var(--border);
    border-radius: 32px;
    background:
      radial-gradient(circle at top right, rgba(232, 163, 58, 0.2), transparent 38%),
      var(--surface);
    box-shadow: var(--shadow);
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }

  .hero-card strong {
    display: block;
    margin-bottom: 0.9rem;
    font-size: 1.45rem;
    line-height: 1.2;
  }

  .section {
    padding-top: clamp(3rem, 7vw, 5.5rem);
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 2rem;
  }

  .cards-grid,
  .steps-grid,
  .reason-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .problem-card,
  .step-card,
  .reason-list li {
    border: 1px solid var(--border);
    border-radius: 24px;
    background: var(--surface);
    padding: 1.2rem;
    box-shadow: 0 10px 30px rgba(23, 32, 51, 0.06);
  }

  .problem-card span {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-bottom: 1rem;
    border-radius: 999px;
    background: #e4f3ef;
    color: var(--primary-dark);
    font-weight: 900;
  }

  .reassurance {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 2rem;
    align-items: center;
    border-radius: 36px;
    background: var(--primary-dark);
    color: #ffffff;
    padding-top: clamp(2rem, 6vw, 3.5rem);
    padding-bottom: clamp(2rem, 6vw, 3.5rem);
  }

  .reassurance .eyebrow,
  .reassurance p {
    color: #d6eef3;
  }

  .reassurance h2 {
    color: #ffffff;
  }

  .reassurance p:last-child {
    margin-bottom: 0;
    font-size: 1.12rem;
  }

  .steps-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .step-card {
    position: relative;
    padding-top: 4rem;
  }

  .step-number {
    position: absolute;
    top: 1.2rem;
    left: 1.2rem;
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 14px;
    background: var(--accent);
    color: var(--text);
    font-weight: 900;
  }

  .examples {
    border-radius: 36px;
    background: var(--surface-soft);
  }

  .example-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .example-list li {
    border-left: 5px solid var(--accent);
    border-radius: 18px;
    background: var(--surface);
    padding: 1rem 1.1rem;
    color: var(--text);
  }

  .reason-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .reason-list p {
    margin-bottom: 0;
  }

  .final-cta {
    margin-top: clamp(2rem, 5vw, 4rem);
    margin-bottom: clamp(2rem, 5vw, 4rem);
    border-radius: 36px;
    background: var(--surface);
    box-shadow: var(--shadow);
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
    padding-bottom: clamp(2.5rem, 7vw, 4.5rem);
    text-align: center;
  }

  .final-cta p {
    max-width: 620px;
    margin-right: auto;
    margin-left: auto;
    font-size: 1.16rem;
  }

  .final-cta .button {
    margin: 0.75rem 0 1rem;
  }

  .final-cta span {
    display: block;
    color: var(--primary-dark);
    font-weight: 800;
  }

  .site-footer {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 1rem;
    border-top: 1px solid var(--border);
    padding-top: 2rem;
    padding-bottom: 2rem;
    color: var(--muted);
    font-size: 0.98rem;
  }

  .site-footer p {
    margin-bottom: 0;
  }

  .site-footer strong,
  .site-footer a {
    color: var(--text);
  }

  :focus-visible {
    outline: 4px solid rgba(232, 163, 58, 0.9);
    outline-offset: 4px;
  }

  @media (max-width: 920px) {
    .site-header {
      align-items: stretch;
      flex-direction: column;
    }

    .site-nav {
      justify-content: flex-start;
      flex-wrap: wrap;
    }

    .header-phone {
      width: 100%;
    }

    .hero,
    .reassurance {
      grid-template-columns: 1fr;
    }

    .cards-grid,
    .steps-grid,
    .reason-list,
    .example-list,
    .site-footer {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    body {
      font-size: 17px;
    }

    .site-nav {
      display: none;
    }

    h1 {
      font-size: clamp(2.1rem, 13vw, 3rem);
      letter-spacing: -0.045em;
    }

    h2 {
      font-size: clamp(1.8rem, 10vw, 2.35rem);
      letter-spacing: -0.035em;
    }

    .button,
    .hero-actions .button {
      width: 100%;
    }

    .phone-placeholder {
      width: 100%;
      text-align: center;
    }

    .problem-card,
    .step-card,
    .reason-list li,
    .example-list li {
      padding: 1rem;
    }
  }
</style>
